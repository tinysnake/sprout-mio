# SQLite 文件路径，默认 ./data/sprout.sqlite。
DATABASE_URL=./data/sprout.sqlite
# 主 origin：auth 的 baseURL、cookie 与回调都按它生成，不含尾斜杠或路径。默认 http://localhost:3000。
# 从局域网或 VPN 访问时把它设成常用地址，例如 http://10.0.0.13:3000。
APP_ORIGIN=http://localhost:3000
# 额外可信 origin，逗号分隔，用于同一进程经其他内网 / VPN 地址访问。
# 主机段可用 * 通配（只允许替换末尾段或作为通配主机名），且必须落在回环或内网网段。
# 例如 http://10.144.144.*:3000,http://*.local:3000；公网域名与非内网地址会被拒绝。
APP_TRUSTED_ORIGINS=
# auth 必填，无默认值。用 openssl rand -base64 32 生成，至少 32 字符。
# 不要使用旧示例占位值或把真实 secret 提交到 Git。
BETTER_AUTH_SECRET=
# 认证限流始终启用。账号预算 5 次/60 秒；server function 总预算 100 次/60 秒。
# HTTP 预算为每 IP、每路径 100 次/60 秒；IP header 仅在受信代理后才可靠。
# MAX 为 1 到 1000，WINDOW_SECONDS 为 1 到 3600，GLOBAL_MAX/HTTP_MAX 为 1 到 10000 的整数。
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_GLOBAL_MAX=100
AUTH_RATE_LIMIT_HTTP_MAX=100
# 默认 3000，整数范围 1 到 65535。
PORT=3000
# 不要在这里设置 NODE_ENV。它会覆盖 vite 的构建模式：写成 development 会让 `pnpm build`
# 以 dev 运行时打包，产物 prerender 报 "jsxDEV is not a function" 并失败。
# 运行时默认 development，需要时用 shell 环境变量临时指定，别写进 .env / .env.local。
# NODE_ENV=development
# 默认 info，可选 debug、info、warn、error。
LOG_LEVEL=info
# Node 生产入口默认不读 .env.local。pnpm start 已显式使用 --env-file-if-exists=.env.local。
# 其他配置文件用 node --env-file=/absolute/path/to/env .output/server/index.mjs。
# 迁移 CLI 的既有配置显式读 .env.local 和 .env，shell 中的环境变量优先。
