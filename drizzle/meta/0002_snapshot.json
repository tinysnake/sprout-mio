        "agent_run_status_check": {
          "name": "agent_run_status_check",
          "value": "\"agent_run\".\"status\" in ('queued', 'running', 'completed', 'failed', 'aborted', 'interrupted')"
        },
        "agent_run_timestamps_check": {
          "name": "agent_run_timestamps_check",
          "value": "(\n      (\"agent_run\".\"status\" = 'queued' and \"agent_run\".\"started_at\" is null and \"agent_run\".\"settled_at\" is null)\n      or (\"agent_run\".\"status\" = 'running' and \"agent_run\".\"started_at\" is not null and \"agent_run\".\"settled_at\" is null)\n      or (\"agent_run\".\"status\" in ('completed', 'failed', 'aborted', 'interrupted') and \"agent_run\".\"settled_at\" is not null)\n    )"
        },
        "agent_run_completed_check": {
          "name": "agent_run_completed_check",
          "value": "\"agent_run\".\"status\" != 'completed' or (\n      \"agent_run\".\"assistant_message_id\" is not null and \"agent_run\".\"config_snapshot\" is not null\n      and \"agent_run\".\"started_at\" is not null and \"agent_run\".\"stop_reason\" is not null and \"agent_run\".\"stop_reason\" = 'stop'\n      and \"agent_run\".\"error_code\" is null and \"agent_run\".\"error_message\" is null\n    )"
        }
      }
